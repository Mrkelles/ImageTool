# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side API key from https://resend.com/api-keys for contact form delivery.
RESEND_API_KEY="re_your_resend_api_key"

# RESEND_FROM_EMAIL: Verified sender address in Resend (defaults to Resend's onboarding sender for testing).
RESEND_FROM_EMAIL="ImageTools <onboarding@resend.dev>"

# CONTACT_TO_EMAIL: Destination inbox that receives contact form submissions.
CONTACT_TO_EMAIL="support@example.com"
